---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { person, personId, site } from '../data/site';
const [msc, bsc] = person.education;
import portrait from '../assets/work/portrait.jpg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  givenName: person.givenName,
  familyName: person.familyName,
  '@id': personId,
  url: `${site.url}/`,
  jobTitle: person.role,
  homeLocation: { '@type': 'Place', name: person.location },
  sameAs: [person.github, person.linkedin],
  worksFor: { '@type': 'Organization', name: person.company.name, legalName: person.company.legalName, url: person.company.url },
  hasOccupation: { '@type': 'Occupation', name: person.company.role },
  alumniOf: person.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.institution })),
  // The past employer as one line: schema.org has no past-employer property, so it travels in the description.
  description: `${person.role} in ${person.location}. ${msc.degree} at ${msc.institution}, ${msc.classification}; ${bsc.degree} at ${bsc.institution}, ${bsc.classification}. ${person.company.role} at ${person.company.legalName} since ${person.company.since}; formerly ${person.pastEmployer.role} at ${person.pastEmployer.name}, ${person.pastEmployer.years}.`,
  // A stable URL (public/media/portrait.jpg), not a hashed build artefact.
  image: new URL('/media/portrait.jpg', site.url).toString(),
};
const description = `About ${person.name}: UCL MSc in AI and Medical Imaging (on track for Distinction), BSc (Hons) Computer Science at City (2:1), Managing Director and AI Engineer at NeuralTake, formerly a quantitative research consultant to WorldQuant Brain. London.`;
---

<Base title="About" description={description} jsonLd={jsonLd} ogImageAlt={`About ${person.name}`}>
  <section class="container about">
    <div class="grid about__grid">
      <h1 class="display about__title" data-reveal="mask">I like models that know their limits and products that people keep using.</h1>
      <figure class="about__portrait" data-reveal="block">
        <div class="print print--lift">
          <Image src={portrait} alt="Portrait photograph of Michal Kaszubski." width={460} height={460} widths={[300, 460]} sizes="(min-width: 900px) 18rem, 60vw" loading="eager" decoding="async" />
        </div>
        <figcaption class="small muted">Michal Kaszubski, London.</figcaption>
      </figure>
      <div class="about__text">
        <div class="about__body" data-reveal-group>
          <p>I am an AI/ML engineer and founder in London. My MSc in Artificial Intelligence and Medical Imaging at UCL (2025 to 2026, on track for Distinction) asked whether a model for flagging distorted prostate MRI could also tell when its own judgement was unreliable. Before that I read Computer Science at City, University of London (BSc Hons, 2:1), where I was president of two societies.</p>
          <p>I founded NeuralTake, my AI consultancy, in October 2024. Through it I scope, build and support production AI software for clients, among them AI Zuzi, a social-media platform I engineer for a client company. From October 2023 to October 2024 I was a quantitative research consultant to WorldQuant Brain, researching and backtesting systematic trading signals in Python. I also build products of my own, NeuralKite for acquisition research and ChefBot, a cooking assistant on GPT, and I run two automated API pipelines for generated music and short-form video.</p>
          <p>To get in touch, message me on <ExternalLink href={person.linkedin} class="tap">LinkedIn</ExternalLink>. CV and references are available on request.</p>
        </div>
        <dl class="about__facts facts print panel" data-reveal="block">
          <div><dt>Education</dt><dd>{msc.degree}, {msc.institution}, {msc.years}, {msc.classification}</dd><dd>{bsc.degree}, {bsc.institution}, {bsc.classification}</dd></div>
          <div><dt>Currently</dt><dd>{person.company.role}, <ExternalLink href={person.company.url}>NeuralTake</ExternalLink>, since {person.company.since}</dd></div>
          <div><dt>Previously</dt><dd>{person.pastEmployer.role}, {person.pastEmployer.name}, {person.pastEmployer.years}</dd></div>
          <div><dt>Interests</dt><dd>Reliable ML, production AI, product building, creative experimentation</dd></div>
          <div><dt>Location</dt><dd>{person.location}</dd></div>
          <div><dt>GitHub</dt><dd><ExternalLink href={person.github}>github.com/Cashubski</ExternalLink></dd></div>
          <div><dt>LinkedIn</dt><dd><ExternalLink href={person.linkedin}>linkedin.com/in/m1k</ExternalLink></dd></div>
          <div><dt>CV</dt><dd><a href="/cv">Read the curriculum vitae</a></dd><dd>PDF and references on request</dd></div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .about { padding-top: var(--space-8); }
  .about__grid { row-gap: var(--space-7); }
  .about__title { grid-column: 1 / span 10; font-size: var(--step-4); max-width: 20ch; }
  .about__portrait { grid-column: 1 / span 4; margin: 0; display: grid; gap: var(--space-4); align-content: start; justify-items: start; }
  .about__portrait .print { width: 100%; max-width: 18rem; }
  .about__portrait :global(img) { width: 100%; height: auto; }
  .about__text { grid-column: 6 / span 7; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-7); min-width: 0; }
  .about__text > * { min-width: 0; }
  .about__facts dd { overflow-wrap: anywhere; min-width: 0; }
  .about__facts dd + dd { grid-column: 2; }
  .about__body { display: grid; gap: 1em; color: var(--ink-2); max-width: var(--measure-narrow); font-size: var(--step-1); line-height: 1.5; }
  .about__facts { max-width: 40rem; background: var(--paper-deep); }
  .about__facts > div { grid-template-columns: 6.5rem minmax(0, 1fr); }
  @media (max-width: 360px) { .about__facts > div { grid-template-columns: 5rem minmax(0, 1fr); } }
  .about__facts > div:first-child { border-top: 0; }
  @media (max-width: 900px) {
    .about__title { grid-column: 1 / -1; }
    .about__portrait { grid-column: 1 / span 5; }
    .about__text { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .about__portrait { grid-column: 1 / -1; }
    .about__portrait .print { max-width: 12rem; }
  }
</style>
