---
/**
 * The CV page, rebuilt from Michal's real CV (BRIEF.md §14.5) in its order: education, experience,
 * projects, skills, languages and certifications, with the PDF offered unaltered. Public-safe: no
 * address or phone on the page; the email is assembled in the browser by the Email component.
 */
import Base from '../layouts/Base.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { person } from '../data/site';
const [msc, bsc] = person.education;
const description = `Curriculum vitae of ${person.name}, AI/ML engineer and founder in London: UCL MSc in AI and Medical Imaging, NeuralTake, WorldQuant Brain, MIQA, ChefBot, AI Zuzi and NeuralKite.`;
---

<Base title="CV" description={description} bodyClass="cv-page">
  <article class="container cv">
    <header class="cv__head">
      <div class="cv__head-row">
        <div>
          <h1 class="display cv__name" data-reveal="mask">Michal Kaszubski</h1>
          <p class="cv__role">{person.role}</p>
        </div>
        <div class="cv__contact small" data-reveal>
          <p>{person.location}</p>
          <p><ExternalLink href={person.github}>github.com/Cashubski</ExternalLink></p>
          <p><ExternalLink href={person.linkedin}>linkedin.com/in/m1k</ExternalLink></p>
          <p><a href="/">kaszub.ski</a></p>
        </div>
      </div>
      <div class="cv__actions no-print" data-reveal>
        <span class="cv__pdf">PDF and references available on request</span>
        <button type="button" class="cv__print" data-print hidden>Print this page</button>
        <p class="small muted cv__pdf-note">The PDF is the CV as supplied in September 2026. This page carries its facts without the phone number.</p>
      </div>
    </header>

    <section class="cv__section">
      <h2 class="cv__h2 serif" data-reveal>Profile</h2>
      <p class="cv__lead">{person.lede} My research is on model reliability in medical imaging (UCL MSc). I run NeuralTake, my AI consultancy, through which I engineer AI Zuzi, a production platform for a client company; before that I researched systematic trading signals as a consultant to WorldQuant Brain. I have built NeuralKite for acquisition research and ChefBot, a cooking assistant on GPT.</p>
    </section>

    <section class="cv__section" data-rule>
      <h2 class="cv__h2 serif" data-reveal>Education</h2>
      <div class="cv__entry" data-reveal>
        <div class="cv__when small num">{msc.years}</div>
        <div class="cv__what">
          <h3 class="cv__h3">{msc.degree}, {msc.institution}, {msc.classification}</h3>
          <p class="cv__sub small muted">{msc.department}, London</p>
          <ul>
            <li>Focus: high-dimensional medical image analysis (MRI and CT), deep learning and foundation models, image reconstruction and inverse problems, robustness and evaluation of AI in safety-critical settings.</li>
            <li>Trained and fine-tuned convolutional and transformer models on UCL’s GPU clusters, optimising memory use and run time for medical imaging data.</li>
          </ul>
        </div>
      </div>
      <div class="cv__entry" data-reveal>
        <div class="cv__when small num" aria-hidden="true"></div>
        <div class="cv__what">
          <h3 class="cv__h3">{bsc.degree}, {bsc.institution}, {bsc.classification}</h3>
          <ul>
            <li>President, City Wealth Management Society: led a society of 115+ members, secured external sponsorship and a Bright Network partnership, and organised competitions and speaker events including Paul Donovan of UBS.</li>
            <li>President, Polish Society: grew membership from 0 to 100+ in one year, winning City SU’s 2023 Most Improved Society Award.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="cv__section" data-rule>
      <h2 class="cv__h2 serif" data-reveal>Experience</h2>
      <div class="cv__entry" data-reveal>
        <div class="cv__when small num">{person.company.since} to present</div>
        <div class="cv__what">
          <h3 class="cv__h3">{person.company.role}, {person.company.legalName} ({person.company.name}), London</h3>
          <ul>
            <li>Founded an AI consultancy that automates manual workflows for professional services firms: a two-week embedded workflow audit with a ranked punch list, then fixed-fee builds live in two to six weeks, with thirty days of post-launch defect cover.</li>
            <li>Secured and delivered signed B2B AI software and consultancy contracts end to end, owning stakeholder discovery, scoping, requirements, architecture, delivery, onboarding, support and roadmap.</li>
            <li>Designed, built and deployed a production AI SaaS in Django, React and PostgreSQL, supporting AI-assisted content generation, multilingual workflows, payments and seven third-party integrations, for approximately 50 business users.</li>
            <li>Took a client platform from prototype to production through a security audit, encryption at rest, MFA, GDPR-aligned deletion and a zero-data-loss live migration from SQLite to PostgreSQL.</li>
          </ul>
        </div>
      </div>
      <div class="cv__entry" data-reveal>
        <div class="cv__when small num">{person.pastEmployer.years}</div>
        <div class="cv__what">
          <h3 class="cv__h3">{person.pastEmployer.role}, {person.pastEmployer.name}, London</h3>
          <ul>
            <li>Researched and backtested systematic trading signals in Python, evaluating risk-adjusted performance, turnover, decay and robustness.</li>
            <li>Iterated signal formulations and neutralisation choices.</li>
            <li>Documented findings within a global quantitative-research community.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="cv__section" data-rule>
      <h2 class="cv__h2 serif" data-reveal>Projects</h2>
      <div class="cv__entry" data-reveal>
        <div class="cv__when small num">October 2025 to August 2026</div>
        <div class="cv__what">
          <h3 class="cv__h3"><a href="/work/miqa">MIQA</a>, MSc thesis: AI for medical image quality assessment, UCL</h3>
          <ul>
            <li>Benchmarked ResNet-18/50, DenseNet-121 and EfficientNet-B0 on 1,027 UCLH prostate DWI acquisitions from 627 patients under strict patient-level cross-validation. A three-seed DenseNet-121 ensemble reached mean AUROC 0.819 (SD 0.049 across five folds), up to 0.17 AUROC over classical radiomic baselines.</li>
            <li>Built a heterogeneous multi-architecture ensemble reaching 83.6% retained-case accuracy at 70% coverage in a retrospective triage simulation, deferring uncertain scans for review; distilled it into a single model at about one-ninth of the ensemble’s inference cost.</li>
            <li>Open-sourced a reproducible PyTorch pipeline (MIT) with 700+ training runs, CI tests, paired Wilcoxon tests with bootstrap confidence intervals, Grad-CAM interpretability and synthetic-distortion physics validation.</li>
          </ul>
        </div>
      </div>
      <div class="cv__entry" data-reveal>
        <div class="cv__when small num">February 2024 to present</div>
        <div class="cv__what">
          <h3 class="cv__h3"><a href="/work/chefbot">ChefBot</a>, a cooking assistant built on GPT (personal project)</h3>
          <ul>
            <li>Built and deployed a GPT-based cooking assistant on ChatGPT: 25,000+ conversations and a 4.7 rating from 100+ ratings on the GPT store (listing, September 2026). Conversations, not people.</li>
            <li>Designed the multi-step tool-calling and retrieval flows that turn sparse fridge or pantry inputs into a recipe, and iterated the prompts and logic on usage data.</li>
          </ul>
        </div>
      </div>
      <div class="cv__entry" data-reveal>
        <div class="cv__when small num">2026 to present</div>
        <div class="cv__what">
          <h3 class="cv__h3"><a href="/work/aizuzi">AI Zuzi</a>, a client platform engineered through NeuralTake</h3>
          <ul>
            <li>An AI social-media management and content platform for a client company, taken from prototype to production: Django, React and PostgreSQL; publishing to Meta, YouTube, TikTok, Pinterest, Threads, LinkedIn and Google Business Profile, with WordPress blog publishing; generation, Stripe payments and multi-factor sign-in. About 50 business users (stated September 2026).</li>
          </ul>
        </div>
      </div>
      <div class="cv__entry" data-reveal>
        <div class="cv__when small num" aria-hidden="true"></div>
        <div class="cv__what">
          <h3 class="cv__h3"><a href="/work/neuralkite">NeuralKite</a>, acquisition-target intelligence for fragmented UK private markets</h3>
          <ul>
            <li>Built a live product that maps private companies, scores targets against an acquisition thesis and produces decision-ready dossiers, around an email discovery and verification engine written at socket level. Next.js and TypeScript, Prisma and PostgreSQL, Claude agents on the Anthropic SDK, a self-hosted warehouse with a 2.8-million-company Crunchbase dataset. Customer and usage figures not published.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="cv__section" data-rule>
      <h2 class="cv__h2 serif" data-reveal>Skills</h2>
      <dl class="cv__skills" data-reveal>
        <div><dt>Technical</dt><dd>{person.technical}</dd></div>
        <div><dt>Languages</dt><dd>{person.languages}</dd></div>
        <div><dt>Certifications</dt><dd>{person.certifications}</dd></div>
      </dl>
    </section>

    <p class="cv__foot small muted no-print" data-reveal>Facts on this page are as stated on the CV supplied in September 2026; the RSNA competition entry and the two automated content pipelines are on the <a href="/work">index of works</a>. A PDF and references are available on request.</p>
  </article>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('[data-print]');
    if (btn) {
      btn.hidden = false;
      btn.addEventListener('click', () => window.print());
    }
  </script>
</Base>

<style>
  .cv { padding-top: var(--space-8); max-width: 62rem; margin-inline: auto; }
  .cv__head { border-bottom: 1px solid var(--ink); padding-bottom: var(--space-5); margin-bottom: var(--space-6); }
  .cv__head-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-5) var(--space-7); }
  .cv__name { font-size: var(--step-4); margin-top: var(--space-2); }
  .cv__role { font-size: var(--step-1); color: var(--ink); margin-top: var(--space-3); }
  .cv__contact { display: grid; gap: 0.1rem; align-content: end; }
  .cv__contact :global(a) { display: inline-flex; min-height: 2.25rem; align-items: center; }
  .cv__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); margin-top: var(--space-5); }
  .cv__pdf, .cv__print { display: inline-flex; align-items: center; border: 1px solid var(--ink); background: transparent; color: var(--ink); padding: 0.6rem 1rem; border-radius: var(--radius); cursor: pointer; font-weight: 500; min-height: 2.75rem; text-decoration: none; transition: background var(--dur) var(--ease), color var(--dur) var(--ease); }
  .cv__pdf { background: var(--ink); color: var(--paper); }
  .cv__pdf:hover { background: transparent; border-color: var(--cobalt); color: var(--cobalt); }
  .cv__print:hover { background: var(--ink); color: var(--paper); }
  .cv__pdf-note { flex-basis: 100%; }
  .cv__sub { margin-top: 0.2rem; }
  .cv__foot { grid-column: 1 / -1; margin-top: var(--space-6); max-width: var(--measure); }
  /* Inline links keep a comfortable tap height on a phone; block padding on an inline element leaves the line unchanged. */
  .cv__h3 a, .cv__foot a, .cv__contact :global(a.email) { padding-block: 0.5em; }
  .cv__section { display: grid; grid-template-columns: 11rem 1fr; column-gap: var(--space-6); row-gap: var(--space-4); padding-block: var(--space-6); border-top: var(--hairline); }
  /* The header block already closes with an ink rule; the first section does not add a second one. */
  .cv__head + .cv__section { border-top: 0; padding-top: 0; }
  .cv__h2 { font-size: var(--step-2); letter-spacing: var(--tracking-title); line-height: 1.1; grid-column: 1; }
  .cv__section > :not(.cv__h2) { grid-column: 2; }
  .cv__lead { color: var(--ink-2); max-width: var(--measure); }
  .cv__entry { display: grid; grid-template-columns: 8.5rem 1fr; gap: var(--space-4); }
  .cv__entry + .cv__entry { margin-top: var(--space-5); }
  .cv__when { color: var(--muted); padding-top: 0.2rem; }
  .cv__h3 { font-family: var(--font-sans); font-weight: 600; font-size: var(--step-0); line-height: 1.35; }
  .cv__what ul { padding-left: 1.1rem; margin-top: var(--space-2); color: var(--ink-2); font-size: var(--step--1); line-height: 1.5; }
  .cv__what li + li { margin-top: 0.35em; }
  .cv__skills { display: grid; gap: var(--space-3); }
  .cv__skills div { display: grid; grid-template-columns: 8.5rem 1fr; gap: var(--space-4); }
  .cv__skills dt { color: var(--muted); padding-top: 0.15rem; font-size: var(--step--1); }
  .cv__skills dd { color: var(--ink-2); font-size: var(--step--1); line-height: 1.5; }
  @media (max-width: 720px) {
    .cv__section { grid-template-columns: 1fr; }
    .cv__section > :not(.cv__h2) { grid-column: 1; }
    .cv__entry, .cv__skills div { grid-template-columns: 1fr; gap: var(--space-1); }
  }

  /* --- Print: A4, one to two pages ---------------------------------------------- */
  @media print {
    @page { size: A4; margin: 13mm 14mm 14mm; }
    :global(body.cv-page) { font-size: 9.5pt; line-height: 1.35; }
    :global(body.cv-page .site-head), :global(body.cv-page .site-foot), :global(body.cv-page .skip-link) { display: none !important; }
    .cv { padding-top: 0; max-width: none; }
    .cv__head-row { gap: 4mm 10mm; }
    .cv__name { font-size: 22pt; margin-top: 2pt; }
    .cv__role { font-size: 11pt; margin-top: 1pt; }
    .cv__contact { font-size: 8.5pt; gap: 0; }
    .cv__contact :global(a) { padding: 0; min-height: 0; }
    .cv__head { padding-bottom: 6pt; margin-bottom: 4pt; border-bottom: 1pt solid #000; }
    .cv__section { padding-block: 6pt; grid-template-columns: 26mm 1fr; column-gap: 5mm; row-gap: 3pt; border-top: 0.5pt solid #999; break-inside: auto; }
    .cv__head + .cv__section { border-top: 0; }
    .cv__h2 { color: #000; font-size: 11pt; }
    .cv__lead { font-size: 9.5pt; max-width: none; }
    .cv__entry { grid-template-columns: 1fr; gap: 1pt; break-inside: avoid; }
    .cv__entry + .cv__entry { margin-top: 5pt; }
    .cv__when { font-size: 8pt; padding-top: 0; }
    .cv__h3 { font-size: 10pt; line-height: 1.25; }
    .cv__what ul { margin-top: 2pt; padding-left: 4mm; }
    .cv__what li + li { margin-top: 1.5pt; }
    .cv__what ul, .cv__skills dd { font-size: 8.75pt; line-height: 1.32; }
    .cv__skills { gap: 2pt; }
    .cv__skills div { grid-template-columns: 20mm 1fr; gap: 3mm; }
    .cv__skills dt { font-size: 8pt; padding-top: 1pt; }
    .cv__contact :global(a), .cv__contact :global(a::after) { color: #000; }
    .ext::after { display: none; }
  }
</style>
