---
/**
 * The NeuralTake delivery method (BRIEF.md §13.1), as inline SVG in the site's two typefaces.
 * Every stage and duration is published on neuraltake.com (services, how it works, about):
 * the 30-minute call, the two-week embedded workflow audit and its ranked punch list, fixed-fee
 * builds live in 2 to 6 weeks, code in the client's repository and infrastructure, training and
 * runbooks, and 30 days of post-launch defect cover. Stages only: no client, price or outcome figure.
 * Two drawings from one data set: two lanes of five for wide screens, one column for narrow ones.
 */
interface Node { label: string; detail: string; }
interface Lane { name: string; nodes: Node[]; parallelFrom?: number; parallelNote?: string; }
const lanes: Lane[] = [
  {
    name: 'Before anything is built',
    nodes: [
      { label: 'First call', detail: 'Thirty minutes. Is there a workflow here that is worth replacing at all?' },
      { label: 'Workflow audit', detail: 'Two weeks embedded with the team, watching how the work moves, not how the organisation chart says it does.' },
      { label: 'Ranked punch list', detail: 'Every process worth automating, ranked by hours saved a week, in writing. The client keeps it either way.' },
      { label: 'The honest no', detail: 'Some items should be a process change, not software. The list says which, even when that costs the engagement.' },
      { label: 'Fixed scope', detail: 'One workflow. Scope, price and timeline are agreed before week one. No hourly billing.' },
    ],
  },
  {
    name: 'The build, and after it',
    nodes: [
      { label: 'Architecture', detail: 'Designed into the systems the firm already runs: practice management, CRM, documents and email.' },
      { label: 'Build', detail: 'Two to six weeks from kick-off to the workflow running live. The code lives in the client’s repository.' },
      { label: 'Launch', detail: 'Deployed on the client’s own infrastructure, inside their data perimeter. There is no platform of mine to depend on.' },
      { label: 'Training', detail: 'Recorded sessions and plain-English runbooks for the people who own the workflow.' },
      { label: 'Defect cover', detail: 'Thirty days after launch, anything that misbehaves is fixed free. After that the team owns it outright.' },
    ],
  },
];

const DETAIL = 15, LEAD = 21, CHAR = 0.48 * DETAIL;
function wrap(text: string, width: number): string[] {
  const max = Math.floor(width / CHAR);
  const out: string[] = []; let line = '';
  for (const word of text.split(' ')) {
    if (line && (line + ' ' + word).length > max) { out.push(line); line = word; } else { line = line ? line + ' ' + word : word; }
  }
  if (line) out.push(line);
  return out;
}
interface Placed extends Node { x: number; y: number; w: number; lines: string[]; h: number; }
const place = (n: Node, x: number, y: number, w: number): Placed => { const lines = wrap(n.detail, w); return { ...n, x, y, w, lines, h: 30 + lines.length * LEAD }; };
interface Head { x: number; y: number; r: number; }
interface Note { x: number; y: number; text: string; }
interface Drawing { cls: string; w: number; h: number; items: Placed[]; paths: string[]; heads: Head[]; brackets: string[]; laneNames: Note[]; notes: Note[]; }

/* Wide drawing: two rows of five. A row ends by returning down the gap to the start of the next. */
function drawWide(): Drawing {
  const W = 1200, CW = 200, GAP = 50, TOP = 34, ROWGAP = 96;
  const items: Placed[] = [], paths: string[] = [], heads: Head[] = [], brackets: string[] = [], laneNames: Note[] = [], notes: Note[] = [];
  let y = TOP;
  lanes.forEach((lane, li) => {
    const row = lane.nodes.map((n, i) => place(n, i * (CW + GAP), y, CW));
    const rowH = Math.max(...row.map((n) => n.h));
    laneNames.push({ x: 0, y: y - 14, text: lane.name });
    row.forEach((n, i) => {
      items.push(n);
      if (i === 0) return;
      if (lane.parallelFrom !== undefined && i > lane.parallelFrom) return;
      paths.push(`M${n.x - GAP + 7} ${y}H${n.x - 8}`);
      heads.push({ x: n.x - 8, y, r: 0 });
    });
    if (lane.parallelFrom !== undefined) {
      const first = row[lane.parallelFrom], last = row[row.length - 1];
      brackets.push(`M${first.x} ${y - 9}V${y - 14}H${last.x + last.w}V${y - 9}`);
      notes.push({ x: first.x, y: y - 22, text: lane.parallelNote ?? '' });
    }
    if (li < lanes.length - 1) {
      const turn = y + rowH + 30, next = y + rowH + ROWGAP;
      const endX = row[row.length - 1].x + CW;
      paths.push(`M${endX - 8} ${y + rowH + 8}V${turn}H8V${next - 36}`);
      heads.push({ x: 8, y: next - 36, r: 90 });
    }
    y += rowH + ROWGAP;
  });
  return { cls: 'ntm-svg ntm-svg--wide', w: W, h: y - ROWGAP + 6, items, paths, heads, brackets, laneNames, notes };
}

/* Narrow drawing: one column, a lane name above each group, the parallel trio hung off a left rail. */
function drawNarrow(): Drawing {
  const W = 360, FULL = 340, IN = 30, STEP = 44, LANEGAP = 40;
  const items: Placed[] = [], paths: string[] = [], heads: Head[] = [], brackets: string[] = [], laneNames: Note[] = [], notes: Note[] = [];
  let y = 30; let prev: Placed | null = null;
  lanes.forEach((lane) => {
    laneNames.push({ x: 0, y: y - 14, text: lane.name });
    let railTop = 0; const ticks: number[] = [];
    lane.nodes.forEach((n, i) => {
      const inPar = lane.parallelFrom !== undefined && i >= lane.parallelFrom;
      const p = place(n, inPar ? IN : 0, y, inPar ? FULL - IN : FULL);
      items.push(p);
      if (inPar) {
        if (i === lane.parallelFrom) { railTop = (prev ? prev.y + prev.h + 8 : y); notes.push({ x: IN, y: y - 12, text: lane.parallelNote ?? '' }); }
        ticks.push(y);
      } else if (prev) {
        const stop = i === 0 ? y - 38 : y - 12;
        paths.push(`M8 ${prev.y + prev.h + 8}V${stop}`);
        heads.push({ x: 8, y: stop, r: 90 });
      }
      prev = p;
      const nextPar = lane.parallelFrom !== undefined && i + 1 === lane.parallelFrom;
      y += p.h + STEP + (nextPar ? 18 : 0);
    });
    if (ticks.length) {
      const last = items[items.length - 1];
      paths.push(`M8 ${railTop}V${last.y + last.h + 8}`);
      ticks.forEach((t) => { paths.push(`M8 ${t}H${IN - 8}`); heads.push({ x: IN - 8, y: t, r: 0 }); });
      prev = { ...last, x: 0 };
    }
    y += LANEGAP;
  });
  return { cls: 'ntm-svg ntm-svg--narrow', w: W, h: y - STEP - LANEGAP + 6, items, paths, heads, brackets, laneNames, notes };
}

const drawings = [drawWide(), drawNarrow()];
const title = 'The NeuralTake delivery method';
const desc = lanes.map((l) => `${l.name}: ${l.nodes.map((n) => `${n.label}. ${n.detail}`).join(' ')}`).join(' ');
---

<div class="inkband ink">
  <h3 class="inkband__title ntm-title">From a thirty-minute call to a workflow the client owns</h3>
  <p>The method is the one published on neuraltake.com. I run every stage of it myself, so the person who scoped the work is the person who builds it and the person who answers when it misbehaves.</p>
  <figure class="ntm xwide">
    {drawings.map((d, i) => (
      <svg class={d.cls} viewBox={`0 0 ${d.w} ${d.h}`} role="img" aria-labelledby={`ntm-t${i} ntm-d${i}`} xmlns="http://www.w3.org/2000/svg">
        <title id={`ntm-t${i}`}>{title}</title>
        <desc id={`ntm-d${i}`}>{desc}</desc>
        <g class="ntm-links">
          {d.paths.map((p) => <path d={p} />)}
          {d.brackets.map((p) => <path d={p} />)}
          {d.heads.map((h) => <path d="M-5 -4.5L0 0L-5 4.5" transform={`translate(${h.x} ${h.y}) rotate(${h.r})`} />)}
        </g>
        {d.laneNames.map((n) => <text class="ntm-lane" x={n.x} y={n.y}>{n.text}</text>)}
        {d.notes.map((n) => <text class="ntm-note" x={n.x} y={n.y}>{n.text}</text>)}
        {d.items.map((n) => (
          <g transform={`translate(${n.x} ${n.y})`}>
            <line class="ntm-rule" x1="0" y1="0" x2={n.w} y2="0" />
            <text class="ntm-label" x="0" y="28">{n.label}</text>
            {n.lines.map((l, k) => <text class="ntm-detail" x="0" y={52 + k * LEAD}>{l}</text>)}
          </g>
        ))}
      </svg>
    ))}
    <figcaption class="ntm-cap small">
      <span class="ntm-tag">Schematic</span>
      <span class="muted">The NeuralTake engagement, stage by stage, with the durations published on neuraltake.com. Stages only; no client, price or outcome is implied.</span>
    </figcaption>
  </figure>
</div>

<style is:global>
  .prose .ntm-title { font-family: var(--font-serif); font-weight: 400; font-size: var(--step-2); line-height: 1.15; letter-spacing: var(--tracking-title); color: var(--ink); }
  .prose .inkband > .ntm { margin-top: var(--space-7); }
  .ntm-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .ntm-svg--wide { display: none; }
  .ntm-svg--narrow { max-width: 24rem; }
  @media (min-width: 1200px) {
    .ntm-svg--wide { display: block; }
    .ntm-svg--narrow { display: none; }
  }
  .ntm-svg text { font-family: var(--font-sans); font-size: 15px; fill: var(--muted); }
  .ntm-svg .ntm-label { font-family: var(--font-serif); font-size: 21px; letter-spacing: -0.016em; fill: var(--ink); }
  .ntm-svg .ntm-lane { font-size: 14px; fill: var(--cobalt); }
  .ntm-svg .ntm-note { font-size: 13px; fill: var(--muted); }
  .ntm-rule { stroke: var(--ink); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ntm-links path { fill: none; stroke: var(--cobalt); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .ntm-cap { display: grid; justify-items: start; gap: 0.15rem; padding-top: var(--space-3); margin-top: var(--space-5); max-width: var(--measure); }
  .ntm-tag { color: var(--ink); font-weight: 500; }
</style>
