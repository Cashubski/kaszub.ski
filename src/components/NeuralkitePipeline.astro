---
/**
 * NeuralKite email discovery and verification pipeline (BRIEF.md §12.2), as inline SVG in the site's
 * two typefaces. Every stage is a function in /opt/neuraltake/src/lib/agents/discovery.ts or
 * email-protocol-probes.ts; nothing here is a figure, a volume or an accuracy claim.
 * Two drawings from one data set: three lanes of five for wide screens, one column for narrow ones,
 * so the type never scales below a readable size. Same hairline-and-arrow language as Schematic.astro.
 */
interface Node { label: string; detail: string; }
interface Lane { name: string; nodes: Node[]; parallelFrom?: number; parallelNote?: string; }
const lanes: Lane[] = [
  {
    name: 'Discovery, once per company',
    nodes: [
      { label: 'Scraped pages', detail: 'Team, about, homepage, careers and blog pages, kept as HTML and as cleaned text.' },
      { label: 'People extraction', detail: 'JSON-LD Person blocks, schema.org microdata, DOM heuristics and LinkedIn anchors, then a Claude pass on the text. Merged by name.' },
      { label: 'Role classification', detail: 'Owner, director, executive, partner, senior or employee. Principals sort first.' },
      { label: 'Email mining', detail: 'mailto links, plain text and “name (at) domain” forms, kept only when they sit on the company’s own domain.' },
      { label: 'Pattern inference', detail: 'Each matched person and address votes for one of eight formats. Role mailboxes do not vote.' },
    ],
  },
  {
    name: 'The domain, once',
    parallelFrom: 2,
    parallelNote: 'These three run in parallel',
    nodes: [
      { label: 'MX lookup', detail: 'Mail servers in priority order. No MX record means nothing on the domain can receive mail.' },
      { label: 'Provider classification', detail: 'Workspace, Microsoft 365, a filtering gateway, shared hosting or self-hosted, with a note on how far its SMTP replies can be trusted.' },
      { label: 'Catch-all control', detail: 'The recipient check, run on a random mailbox that cannot exist. If it is accepted, the server accepts everything.' },
      { label: 'Protocol probes', detail: 'DKIM selectors, SPF chain, DMARC, MTA-STS, TLS-RPT, BIMI, CAA, SRV, MX reverse DNS, JMAP, WebFinger, CalDAV.' },
      { label: 'Sign-in realm', detail: 'Whether Microsoft manages or federates identity for the domain.' },
    ],
  },
  {
    name: 'The address, once per person',
    nodes: [
      { label: 'Candidates', detail: 'Eight formats built from the cleaned name, the inferred format first.' },
      { label: 'Per-address probes', detail: 'Microsoft sign-in, Exchange Autodiscover, a Google sign-in hint and WebFinger, in parallel. No mail is involved.' },
      { label: 'SMTP recipient check', detail: 'EHLO, MAIL FROM and RCPT TO, then read the reply and QUIT. No DATA command is sent, so no message exists.' },
      { label: 'Risk tier', detail: 'Site evidence, the SMTP reply and the catch-all result combine into one of six tiers.' },
      { label: 'Rationale trail', detail: 'Every signal is appended as a dated step, so the verdict can be read back line by line.' },
    ],
  },
];

const DETAIL = 15, LEAD = 21, CHAR = 0.48 * DETAIL;
function wrap(text: string, width: number): string[] {
  const max = Math.floor(width / CHAR);
  const out: string[] = []; let line = '';
  for (const word of text.split(' ')) {
    if (line && (line + ' ' + word).length > max) { out.push(line); line = word; } else { line = line ? line + ' ' + word : word; }
  }
  if (line) out.push(line);
  return out;
}
interface Placed extends Node { x: number; y: number; w: number; lines: string[]; h: number; }
const place = (n: Node, x: number, y: number, w: number): Placed => { const lines = wrap(n.detail, w); return { ...n, x, y, w, lines, h: 30 + lines.length * LEAD }; };
interface Head { x: number; y: number; r: number; }
interface Note { x: number; y: number; text: string; }
interface Drawing { cls: string; w: number; h: number; items: Placed[]; paths: string[]; heads: Head[]; brackets: string[]; laneNames: Note[]; notes: Note[]; }

/* Wide drawing: three rows of five. A row ends by returning down the gap to the start of the next. */
function drawWide(): Drawing {
  const W = 1200, CW = 200, GAP = 50, TOP = 34, ROWGAP = 96;
  const items: Placed[] = [], paths: string[] = [], heads: Head[] = [], brackets: string[] = [], laneNames: Note[] = [], notes: Note[] = [];
  let y = TOP;
  lanes.forEach((lane, li) => {
    const row = lane.nodes.map((n, i) => place(n, i * (CW + GAP), y, CW));
    const rowH = Math.max(...row.map((n) => n.h));
    laneNames.push({ x: 0, y: y - 14, text: lane.name });
    row.forEach((n, i) => {
      items.push(n);
      if (i === 0) return;
      if (lane.parallelFrom !== undefined && i > lane.parallelFrom) return;
      paths.push(`M${n.x - GAP + 7} ${y}H${n.x - 8}`);
      heads.push({ x: n.x - 8, y, r: 0 });
    });
    if (lane.parallelFrom !== undefined) {
      const first = row[lane.parallelFrom], last = row[row.length - 1];
      brackets.push(`M${first.x} ${y - 9}V${y - 14}H${last.x + last.w}V${y - 9}`);
      notes.push({ x: first.x, y: y - 22, text: lane.parallelNote ?? '' });
    }
    if (li < lanes.length - 1) {
      const turn = y + rowH + 30, next = y + rowH + ROWGAP;
      const endX = row[row.length - 1].x + CW;
      paths.push(`M${endX - 8} ${y + rowH + 8}V${turn}H8V${next - 36}`);
      heads.push({ x: 8, y: next - 36, r: 90 });
    }
    y += rowH + ROWGAP;
  });
  return { cls: 'nkp-svg nkp-svg--wide', w: W, h: y - ROWGAP + 6, items, paths, heads, brackets, laneNames, notes };
}

/* Narrow drawing: one column, a lane name above each group, the parallel trio hung off a left rail. */
function drawNarrow(): Drawing {
  const W = 360, FULL = 340, IN = 30, STEP = 44, LANEGAP = 40;
  const items: Placed[] = [], paths: string[] = [], heads: Head[] = [], brackets: string[] = [], laneNames: Note[] = [], notes: Note[] = [];
  let y = 30; let prev: Placed | null = null;
  lanes.forEach((lane) => {
    laneNames.push({ x: 0, y: y - 14, text: lane.name });
    let railTop = 0; const ticks: number[] = [];
    lane.nodes.forEach((n, i) => {
      const inPar = lane.parallelFrom !== undefined && i >= lane.parallelFrom;
      const p = place(n, inPar ? IN : 0, y, inPar ? FULL - IN : FULL);
      items.push(p);
      if (inPar) {
        if (i === lane.parallelFrom) { railTop = (prev ? prev.y + prev.h + 8 : y); notes.push({ x: IN, y: y - 12, text: lane.parallelNote ?? '' }); }
        ticks.push(y);
      } else if (prev) {
        const stop = i === 0 ? y - 38 : y - 12;
        paths.push(`M8 ${prev.y + prev.h + 8}V${stop}`);
        heads.push({ x: 8, y: stop, r: 90 });
      }
      prev = p;
      const nextPar = lane.parallelFrom !== undefined && i + 1 === lane.parallelFrom;
      y += p.h + STEP + (nextPar ? 18 : 0);
    });
    if (ticks.length) {
      const last = items[items.length - 1];
      paths.push(`M8 ${railTop}V${last.y + last.h + 8}`);
      ticks.forEach((t) => { paths.push(`M8 ${t}H${IN - 8}`); heads.push({ x: IN - 8, y: t, r: 0 }); });
      prev = { ...last, x: 0 };
    }
    y += LANEGAP;
  });
  return { cls: 'nkp-svg nkp-svg--narrow', w: W, h: y - STEP - LANEGAP + 6, items, paths, heads, brackets, laneNames, notes };
}

const drawings = [drawWide(), drawNarrow()];
const title = 'The NeuralKite email discovery and verification pipeline';
const desc = lanes.map((l) => `${l.name}: ${l.nodes.map((n) => `${n.label}. ${n.detail}`).join(' ')}`).join(' ') + ' In the second lane the catch-all control, the protocol probes and the sign-in realm lookup run in parallel.';
---

<div class="inkband ink">
  <h3 class="inkband__title nkp-title">From a team page to a graded address</h3>
  <p>Three passes, in this order in the code. The company’s pages yield people and a house format for addresses. The domain is questioned once. Then each person’s address is built, checked and graded, and the reasons are kept.</p>
  <figure class="nkp xwide">
    {drawings.map((d, i) => (
      <svg class={d.cls} viewBox={`0 0 ${d.w} ${d.h}`} role="img" aria-labelledby={`nkp-t${i} nkp-d${i}`} xmlns="http://www.w3.org/2000/svg">
        <title id={`nkp-t${i}`}>{title}</title>
        <desc id={`nkp-d${i}`}>{desc}</desc>
        <g class="nkp-links">
          {d.paths.map((p) => <path d={p} />)}
          {d.brackets.map((p) => <path d={p} />)}
          {d.heads.map((h) => <path d="M-5 -4.5L0 0L-5 4.5" transform={`translate(${h.x} ${h.y}) rotate(${h.r})`} />)}
        </g>
        {d.laneNames.map((n) => <text class="nkp-lane" x={n.x} y={n.y}>{n.text}</text>)}
        {d.notes.map((n) => <text class="nkp-note" x={n.x} y={n.y}>{n.text}</text>)}
        {d.items.map((n) => (
          <g transform={`translate(${n.x} ${n.y})`}>
            <line class="nkp-rule" x1="0" y1="0" x2={n.w} y2="0" />
            <text class="nkp-label" x="0" y="28">{n.label}</text>
            {n.lines.map((l, k) => <text class="nkp-detail" x="0" y={52 + k * LEAD}>{l}</text>)}
          </g>
        ))}
      </svg>
    ))}
    <figcaption class="nkp-cap small">
      <span class="nkp-tag">Schematic</span>
      <span class="muted">Email discovery and verification in NeuralKite, stage by stage as the code runs it. Stages only; no figures are implied.</span>
    </figcaption>
  </figure>
</div>

<style is:global>
  .prose .nkp-title { font-family: var(--font-serif); font-weight: 400; font-size: var(--step-2); line-height: 1.15; letter-spacing: var(--tracking-title); color: var(--ink); }
  .prose .inkband > .nkp { margin-top: var(--space-7); }
  .nkp-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .nkp-svg--wide { display: none; }
  .nkp-svg--narrow { max-width: 24rem; }
  @media (min-width: 1200px) {
    .nkp-svg--wide { display: block; }
    .nkp-svg--narrow { display: none; }
  }
  .nkp-svg text { font-family: var(--font-sans); font-size: 15px; fill: var(--muted); }
  .nkp-svg .nkp-label { font-family: var(--font-serif); font-size: 21px; letter-spacing: -0.016em; fill: var(--ink); }
  .nkp-svg .nkp-lane { font-size: 14px; fill: var(--cobalt); }
  .nkp-svg .nkp-note { font-size: 13px; fill: var(--muted); }
  .nkp-rule { stroke: var(--ink); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .nkp-links path { fill: none; stroke: var(--cobalt); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .nkp-cap { display: grid; justify-items: start; gap: 0.15rem; padding-top: var(--space-3); margin-top: var(--space-5); max-width: var(--measure); }
  .nkp-tag { color: var(--ink); font-weight: 500; }
</style>
