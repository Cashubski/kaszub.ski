---
/**
 * ChefBot's multi-step flow as an inline SVG, stages only, in the words of BRIEF.md §11.3:
 * photo of the fridge, ingredient recognition, recipe, dietary adaptation, PDF guide.
 * Two drawings of the same five stages: a row for wide columns, a column for phones.
 * Text is set in the site's two typefaces through CSS; no figures, no invented detail.
 */
const title = 'The ChefBot flow, from a photo of the fridge to a PDF guide.';
const stages = [
  { label: ['Photo of', 'the fridge'], detail: ['or a typed list of what', 'is in the cupboard'] },
  { label: ['Ingredient', 'recognition'], detail: ['what is there, read', 'from the photo'] },
  { label: ['Recipe'], detail: ['a meal from those', 'ingredients'] },
  { label: ['Dietary', 'adaptation'], detail: ['tailored to the needs', 'the person states'] },
  { label: ['PDF guide'], detail: ['the recipe as a file', 'to keep'] },
];
const colW = 152;
const x0 = 6;
const rowH = 92;
const desc = `${title} Five stages in order: ${stages.map((s) => s.label.join(' ')).join(', ')}.`;
---

<figure class="cbs wide" aria-label={title}>
  <div class="cbs__plate print panel">
    <svg class="cbs__svg cbs__svg--row" viewBox="0 0 766 172" role="img" aria-label={desc} xmlns="http://www.w3.org/2000/svg">
      <text class="cbs__note" x={x0} y="14">From the person</text>
      <text class="cbs__note" x={x0 + colW} y="14">One flow from a single message, without hand-holding</text>
      <path class="cbs__span" d={`M${x0} 26 H${x0 + colW - 24}`} />
      <path class="cbs__span cbs__span--accent" d={`M${x0 + colW} 26 H760`} />
      <path class="cbs__rule" d={`M${x0} 62 H760`} />
      {stages.map((s, i) => {
        const x = x0 + i * colW;
        return (
          <g>
            <circle class="cbs__node" cx={x + 5} cy="62" r="4.5" />
            {i > 0 && <path class="cbs__arrow" d={`M${x - 22} 57.5 l4.5 4.5 l-4.5 4.5`} />}
            {s.label.map((l, k) => <text class="cbs__label" x={x} y={94 + k * 21}>{l}</text>)}
            {s.detail.map((l, k) => <text class="cbs__detail" x={x} y={94 + s.label.length * 21 + 4 + k * 15}>{l}</text>)}
          </g>
        );
      })}
    </svg>

    <svg class="cbs__svg cbs__svg--col" viewBox="0 0 320 480" role="img" aria-label={desc} xmlns="http://www.w3.org/2000/svg">
      <path class="cbs__rule" d={`M8 12 V${12 + 4 * rowH}`} />
      <path class="cbs__span cbs__span--accent" d={`M8 ${12 + rowH} V${12 + 4 * rowH}`} />
      {stages.map((s, i) => {
        const y = 12 + i * rowH;
        return (
          <g>
            <circle class="cbs__node" cx="8" cy={y} r="4.5" />
            {i > 0 && <path class="cbs__arrow" d={`M3.5 ${y - 20} l4.5 4.5 l4.5 -4.5`} />}
            <text class="cbs__label" x="32" y={y + 7}>{s.label.join(' ')}</text>
            <text class="cbs__detail cbs__detail--col" x="32" y={y + 30}>{s.detail.join(' ')}</text>
          </g>
        );
      })}
      <text class="cbs__note cbs__note--col" x="0" y="432">The first stage comes from the person. The other</text>
      <text class="cbs__note cbs__note--col" x="0" y="452">four run as one flow from a single message,</text>
      <text class="cbs__note cbs__note--col" x="0" y="472">without hand-holding.</text>
    </svg>
  </div>
  <figcaption class="cbs__cap small">
    <span class="cbs__tag">Schematic</span>
    <span class="muted">{title} Stage names only. The flow is built on GPT, which I did not train.</span>
  </figcaption>
</figure>

<style>
  .cbs__plate { background: var(--paper-deep); }
  .cbs__svg { display: block; width: 100%; height: auto; overflow: visible; }
  .cbs__svg--col { display: none; max-width: 22rem; }
  .cbs__rule { stroke: var(--ink); stroke-width: 1; fill: none; }
  .cbs__span { stroke: var(--rule-strong); stroke-width: 1; fill: none; }
  .cbs__span--accent { stroke: var(--cobalt); }
  .cbs__node { fill: var(--paper-deep); stroke: var(--cobalt); stroke-width: 1.4; }
  .cbs__arrow { fill: none; stroke: var(--cobalt); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .cbs__label { font-family: var(--font-serif); font-size: 18px; letter-spacing: -0.016em; fill: var(--ink); }
  .cbs__detail { font-family: var(--font-sans); font-size: 11.5px; fill: var(--muted); }
  .cbs__detail--col { font-size: 13.5px; }
  .cbs__svg--col .cbs__label { font-size: 20px; }
  .cbs__note { font-family: var(--font-sans); font-size: 11.5px; fill: var(--muted); }
  .cbs__note--col { font-size: 13px; }
  .cbs__svg--col .cbs__span--accent { stroke-width: 2; }
  .cbs__cap { display: grid; justify-items: start; gap: 0.15rem; padding-top: var(--space-3); margin-top: var(--space-4); max-width: var(--measure); }
  .cbs__tag { color: var(--ink); font-weight: 500; }
  @media (max-width: 1023.98px) {
    .cbs__svg--row { display: none; }
    .cbs__svg--col { display: block; }
  }
</style>
