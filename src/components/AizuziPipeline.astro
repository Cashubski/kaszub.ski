---
/**
 * AI Zuzi publishing pipeline (BRIEF.md §13.2), as inline SVG in the site's two typefaces.
 * Every stage is read from the private repository: services/user_services/post/create_post.py
 * (JPEG normalisation), taskscheduler.py (the interval jobs, the status values, the retry on Meta
 * subcode 2207027, the permalink fetch, the error handler) and services/task_services/socials
 * (one package per platform). Stages only: no volumes, timings beyond the code's own constants, or success rates.
 * Two drawings from one data set: three lanes of five for wide screens, one column for narrow ones.
 */
interface Node { label: string; detail: string; }
interface Lane { name: string; nodes: Node[]; parallelFrom?: number; parallelNote?: string; }
const lanes: Lane[] = [
  {
    name: 'In the request, when a post is saved',
    nodes: [
      { label: 'Composer', detail: 'Text, media, post type and target channels. Text can be written by hand or generated from parameters, an image or a link.' },
      { label: 'Normalise media', detail: 'PNG, WebP, HEIC and GIF are flattened onto white and re-encoded as JPEG at quality 92, because Instagram accepts JPEG only.' },
      { label: 'Store in R2', detail: 'Media goes to object storage and gets a public URL. The platforms fetch media by URL; they are never sent the bytes.' },
      { label: 'Post row', detail: 'One row per post: a millisecond timestamp, the targets and the status create. Ids and timestamps are 64-bit.' },
      { label: 'Now or later', detail: 'A post due now can publish inside the request. A post due later waits for the scheduler.' },
    ],
  },
  {
    name: 'In the scheduler, one process, every five seconds',
    nodes: [
      { label: 'Initialise', detail: 'Posts that have come due are collected with their profile’s tokens, decrypted in memory.' },
      { label: 'Create containers', detail: 'Media is registered with each platform. A carousel makes one child container per image, then a parent.' },
      { label: 'Check', detail: 'Every sixty seconds, containers still processing are polled until the platform says they are ready.' },
      { label: 'Publish', detail: 'If Meta answers that the media is not ready yet, the post stays in publish and is tried again: up to 20 times, five seconds apart.' },
      { label: 'Permalink and result', detail: 'The real Instagram permalink is fetched and stored, and the post is marked complete. A failure becomes a message and an email.' },
    ],
  },
  {
    name: 'Per channel, routed by how the account was connected',
    parallelFrom: 0,
    parallelNote: 'One task service per platform, called side by side',
    nodes: [
      { label: 'Facebook and Instagram', detail: 'Through a Facebook Page token on the Graph API: image, carousel, reel, image story and video story.' },
      { label: 'Instagram, direct', detail: 'Accounts joined by Instagram Business Login carry a flag and are routed to Instagram’s own Graph host with their own token.' },
      { label: 'Video platforms', detail: 'YouTube by a Data API v3 upload. TikTok by the Content Posting API’s direct-post flow.' },
      { label: 'Feeds and listings', detail: 'LinkedIn text, image, carousel and video posts. Threads, Pinterest pins and Google Business Profile local posts.' },
      { label: 'WordPress', detail: 'Blog posts through the site’s REST API under an application password: ten post formats, scheduling, categories, authors and media.' },
    ],
  },
];

const DETAIL = 15, LEAD = 21, CHAR = 0.48 * DETAIL;
function wrap(text: string, width: number): string[] {
  const max = Math.floor(width / CHAR);
  const out: string[] = []; let line = '';
  for (const word of text.split(' ')) {
    if (line && (line + ' ' + word).length > max) { out.push(line); line = word; } else { line = line ? line + ' ' + word : word; }
  }
  if (line) out.push(line);
  return out;
}
interface Placed extends Node { x: number; y: number; w: number; lines: string[]; h: number; }
const place = (n: Node, x: number, y: number, w: number): Placed => { const lines = wrap(n.detail, w); return { ...n, x, y, w, lines, h: 30 + lines.length * LEAD }; };
interface Head { x: number; y: number; r: number; }
interface Note { x: number; y: number; text: string; }
interface Drawing { cls: string; w: number; h: number; items: Placed[]; paths: string[]; heads: Head[]; brackets: string[]; laneNames: Note[]; notes: Note[]; }

/* Wide drawing: three rows of five. A row ends by returning down the gap to the start of the next. */
function drawWide(): Drawing {
  const W = 1200, CW = 200, GAP = 50, TOP = 34, ROWGAP = 96;
  const items: Placed[] = [], paths: string[] = [], heads: Head[] = [], brackets: string[] = [], laneNames: Note[] = [], notes: Note[] = [];
  let y = TOP;
  lanes.forEach((lane, li) => {
    const allPar = lane.parallelFrom === 0;
    if (allPar) y += 26;
    const row = lane.nodes.map((n, i) => place(n, i * (CW + GAP), y, CW));
    const rowH = Math.max(...row.map((n) => n.h));
    laneNames.push({ x: 0, y: y - (allPar ? 40 : 14), text: lane.name });
    row.forEach((n, i) => {
      items.push(n);
      if (i === 0) return;
      if (lane.parallelFrom !== undefined && i > lane.parallelFrom) return;
      if (lane.parallelFrom === 0) return;
      paths.push(`M${n.x - GAP + 7} ${y}H${n.x - 8}`);
      heads.push({ x: n.x - 8, y, r: 0 });
    });
    if (lane.parallelFrom !== undefined) {
      const first = row[lane.parallelFrom], last = row[row.length - 1];
      brackets.push(`M${first.x} ${y - 9}V${y - 14}H${last.x + last.w}V${y - 9}`);
      notes.push({ x: first.x, y: y - 22, text: lane.parallelNote ?? '' });
    }
    if (li < lanes.length - 1) {
      const turn = y + rowH + 30, next = y + rowH + ROWGAP;
      const endX = row[row.length - 1].x + CW;
      paths.push(`M${endX - 8} ${y + rowH + 8}V${turn}H8V${next - 36}`);
      heads.push({ x: 8, y: next - 36, r: 90 });
    }
    y += rowH + ROWGAP;
  });
  return { cls: 'azp-svg azp-svg--wide', w: W, h: y - ROWGAP + 6, items, paths, heads, brackets, laneNames, notes };
}

/* Narrow drawing: one column, a lane name above each group, the parallel trio hung off a left rail. */
function drawNarrow(): Drawing {
  const W = 360, FULL = 340, IN = 30, STEP = 44, LANEGAP = 40;
  const items: Placed[] = [], paths: string[] = [], heads: Head[] = [], brackets: string[] = [], laneNames: Note[] = [], notes: Note[] = [];
  let y = 30; let prev: Placed | null = null;
  lanes.forEach((lane) => {
    laneNames.push({ x: 0, y: y - 14, text: lane.name });
    const allPar = lane.parallelFrom === 0;
    if (allPar) {
      if (prev) { paths.push(`M8 ${prev.y + prev.h + 8}V${y - 38}`); heads.push({ x: 8, y: y - 38, r: 90 }); }
      y += 26;
    }
    let railTop = 0; const ticks: number[] = [];
    lane.nodes.forEach((n, i) => {
      const inPar = lane.parallelFrom !== undefined && i >= lane.parallelFrom;
      const p = place(n, inPar ? IN : 0, y, inPar ? FULL - IN : FULL);
      items.push(p);
      if (inPar) {
        if (i === lane.parallelFrom) { railTop = allPar ? y - 30 : (prev ? prev.y + prev.h + 8 : y); notes.push({ x: IN, y: y - 12, text: lane.parallelNote ?? '' }); }
        ticks.push(y);
      } else if (prev) {
        const stop = i === 0 ? y - 38 : y - 12;
        paths.push(`M8 ${prev.y + prev.h + 8}V${stop}`);
        heads.push({ x: 8, y: stop, r: 90 });
      }
      prev = p;
      const nextPar = lane.parallelFrom !== undefined && i + 1 === lane.parallelFrom;
      y += p.h + STEP + (nextPar ? 18 : 0);
    });
    if (ticks.length) {
      const last = items[items.length - 1];
      paths.push(`M8 ${railTop}V${last.y + last.h + 8}`);
      ticks.forEach((t) => { paths.push(`M8 ${t}H${IN - 8}`); heads.push({ x: IN - 8, y: t, r: 0 }); });
      prev = { ...last, x: 0 };
    }
    y += LANEGAP;
  });
  return { cls: 'azp-svg azp-svg--narrow', w: W, h: y - STEP - LANEGAP + 6, items, paths, heads, brackets, laneNames, notes };
}

const drawings = [drawWide(), drawNarrow()];
const title = 'The AI Zuzi publishing pipeline';
const desc = lanes.map((l) => `${l.name}: ${l.nodes.map((n) => `${n.label}. ${n.detail}`).join(' ')}`).join(' ') + ' The channels in the third lane are independent of one another.';
---

<div class="inkband ink">
  <h3 class="inkband__title azp-title">From the composer to a live post</h3>
  <p>Three parts, as the code runs them. The request turns a draft into a row the scheduler can act on. One scheduler process walks each due post through a small state machine. Each channel has its own task service, chosen by how the account was connected.</p>
  <figure class="azp xwide">
    {drawings.map((d, i) => (
      <svg class={d.cls} viewBox={`0 0 ${d.w} ${d.h}`} role="img" aria-labelledby={`azp-t${i} azp-d${i}`} xmlns="http://www.w3.org/2000/svg">
        <title id={`azp-t${i}`}>{title}</title>
        <desc id={`azp-d${i}`}>{desc}</desc>
        <g class="azp-links">
          {d.paths.map((p) => <path d={p} />)}
          {d.brackets.map((p) => <path d={p} />)}
          {d.heads.map((h) => <path d="M-5 -4.5L0 0L-5 4.5" transform={`translate(${h.x} ${h.y}) rotate(${h.r})`} />)}
        </g>
        {d.laneNames.map((n) => <text class="azp-lane" x={n.x} y={n.y}>{n.text}</text>)}
        {d.notes.map((n) => <text class="azp-note" x={n.x} y={n.y}>{n.text}</text>)}
        {d.items.map((n) => (
          <g transform={`translate(${n.x} ${n.y})`}>
            <line class="azp-rule" x1="0" y1="0" x2={n.w} y2="0" />
            <text class="azp-label" x="0" y="28">{n.label}</text>
            {n.lines.map((l, k) => <text class="azp-detail" x="0" y={52 + k * LEAD}>{l}</text>)}
          </g>
        ))}
      </svg>
    ))}
    <figcaption class="azp-cap small">
      <span class="azp-tag">Schematic</span>
      <span class="muted">Publishing in AI Zuzi, stage by stage as the code runs it. The only numbers are constants in the source; no volumes or success rates are implied.</span>
    </figcaption>
  </figure>
</div>

<style is:global>
  .prose .azp-title { font-family: var(--font-serif); font-weight: 400; font-size: var(--step-2); line-height: 1.15; letter-spacing: var(--tracking-title); color: var(--ink); }
  .prose .inkband > .azp { margin-top: var(--space-7); }
  .azp-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .azp-svg--wide { display: none; }
  .azp-svg--narrow { max-width: 24rem; }
  @media (min-width: 1200px) {
    .azp-svg--wide { display: block; }
    .azp-svg--narrow { display: none; }
  }
  .azp-svg text { font-family: var(--font-sans); font-size: 15px; fill: var(--muted); }
  .azp-svg .azp-label { font-family: var(--font-serif); font-size: 21px; letter-spacing: -0.016em; fill: var(--ink); }
  .azp-svg .azp-lane { font-size: 14px; fill: var(--cobalt); }
  .azp-svg .azp-note { font-size: 13px; fill: var(--muted); }
  .azp-rule { stroke: var(--ink); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .azp-links path { fill: none; stroke: var(--cobalt); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .azp-cap { display: grid; justify-items: start; gap: 0.15rem; padding-top: var(--space-3); margin-top: var(--space-5); max-width: var(--measure); }
  .azp-tag { color: var(--ink); font-weight: 500; }
</style>
