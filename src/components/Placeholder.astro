---
/**
 * Restrained typographic placeholder for assets or facts not yet supplied.
 * `kind` = 'figure' is a short plate: a serif line set top-left on paper-deep with the print
 * shadow, then a hairline and a small sans foot carrying the label and a dated note. It takes
 * the height of its text and no more (no aspect-ratio void). 'line' is a one-line ruled note.
 */
interface Props { text: string; kind?: 'figure' | 'line'; label?: string; note?: string; size?: 'default' | 'lead'; flush?: boolean; }
const { text, kind = 'figure', label = 'Placeholder', note, size = 'default', flush = false } = Astro.props;
---

{kind === 'figure' ? (
  <div class:list={['ph ph--figure print panel', { 'ph--lead': size === 'lead' }]} role="note">
    <p class="ph__text">{text}</p>
    <p class="ph__foot small">
      <span class="ph__label">{label}</span>
      {note && <span class="muted">{note}</span>}
    </p>
  </div>
) : (
  <p class:list={['ph ph--line small', { 'ph--flush': flush }]} role="note">
    <span class="ph__label">{label}</span>
    <span class="ph__text">{text}</span>
  </p>
)}

<style>
  .ph--figure { display: grid; gap: var(--space-4); align-content: start; }
  .ph--figure .ph__text {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.3;
    letter-spacing: var(--tracking-title);
    color: var(--ink);
    max-width: 40ch;
  }
  .ph--lead .ph__text { font-size: var(--step-2); line-height: 1.25; max-width: 30ch; }
  .ph__foot {
    display: flex; flex-wrap: wrap; gap: 0.15rem var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule-strong);
    max-width: var(--measure);
  }
  .ph__label { color: var(--ink); font-weight: 500; flex: none; }
  .ph--line {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: var(--hairline);
    color: var(--muted);
  }
</style>
