---
/**
 * The engineering stack Michal works in and the infrastructure he runs (BRIEF.md §13.1).
 * `kind="stack"`: each row names where the evidence is, the AI Zuzi repository (read 20 September 2026),
 * the NeuralKite codebase (BRIEF.md §5.3 and §12.2) or neuraltake.com's own source.
 * `kind="infra"`: the list in BRIEF.md §13.1 plus what the two codebases deploy with. No hosts, addresses or counts.
 * Styles are shared with NeuraltakeServices (.nt-table).
 */
interface Props { kind: 'stack' | 'infra'; }
interface Row { layer: string; parts: string[]; where: string; }
const { kind } = Astro.props;
const stack: Row[] = [
  { layer: 'Back ends', parts: ['Python: Django 5, Django REST Framework', 'TypeScript: Next.js App Router, Prisma'], where: 'AI Zuzi is a Django REST API behind a React single-page app. NeuralKite is a Next.js application with streaming endpoints.' },
  { layer: 'Front ends', parts: ['React 18, Vite, Tailwind CSS, Radix', 'Next.js, react-i18next'], where: 'A single-page app in five languages for AI Zuzi; server-rendered React for NeuralKite and for neuraltake.com itself.' },
  { layer: 'Models and agents', parts: ['Anthropic SDK, OpenAI API, xAI API', 'retrieval, tool use, structured output'], where: 'Claude agents that score, research and draft in NeuralKite. Text, vision, assistant threads, image and video generation in AI Zuzi.' },
  { layer: 'Data', parts: ['PostgreSQL, SQLite, Prisma, the Django ORM', 'migrations, ETL, sequence and key handling'], where: 'A zero-data-loss live migration from SQLite to PostgreSQL on AI Zuzi. A self-hosted warehouse holding a 2.8-million-company Crunchbase load for NeuralKite.' },
  { layer: 'Identity and payments', parts: ['JWT, TOTP and email one-time codes, NextAuth', 'Stripe Checkout, webhooks, invoices, billing'], where: 'Multi-factor sign-in and a token economy on AI Zuzi; subscription billing on NeuralKite.' },
  { layer: 'Integrations', parts: ['Meta Graph, Instagram, YouTube, TikTok, LinkedIn, Pinterest, Threads, Google Business Profile, WordPress', 'Companies House, SMTP and DNS at socket level'], where: 'OAuth connections and publishing services in AI Zuzi. Registry data and a mailbox verification engine in NeuralKite.' },
  { layer: 'Security', parts: ['Field encryption at rest', 'SSRF guards, rate limits, CSP, log redaction'], where: 'Stored OAuth tokens in AI Zuzi and stored SMTP passwords in NeuralKite are encrypted before they reach the database. GDPR-aligned deletion with a thirty-day purge on AI Zuzi.' },
  { layer: 'Quality', parts: ['pytest, GitHub Actions, Sentry', 'structured audit logging'], where: 'AI Zuzi deploys from main only when its automated tests and its front-end build pass.' },
];
const infra: Row[] = [
  { layer: 'Servers', parts: ['A fleet of Ubuntu VPS machines', 'Docker, Google Cloud Run'], where: 'Long-running applications, databases and mail sit on the VPS fleet; containerised services go to Cloud Run.' },
  { layer: 'Web', parts: ['nginx, Let’s Encrypt', 'Apache with mod_wsgi where a client already runs it'], where: 'Reverse proxying, static sites and TLS certificates. This site is served by the same nginx.' },
  { layer: 'Processes', parts: ['pm2 for Node applications', 'cron for scheduled jobs'], where: 'Restarts on failure, logs, and scheduled jobs such as database backups.' },
  { layer: 'Databases', parts: ['Self-hosted PostgreSQL'], where: 'Application databases and the Crunchbase warehouse, with dumps taken from the live server.' },
  { layer: 'Mail', parts: ['A self-hosted Postal mail server'], where: 'Transactional and outreach sending with delivery, open, click and bounce events returned by webhook.' },
];
const rows = kind === 'stack' ? stack : infra;
const heads = kind === 'stack' ? ['Area', 'What I work in', 'Where it is in use'] : ['Layer', 'What I run', 'What it is for'];
---

<div class="table-wrap wide nt-table nt-stack">
  <table>
    <thead>
      <tr>{heads.map((h) => <th scope="col">{h}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td>{r.layer}</td>
          <td>{r.parts.map((p) => <span class="nt-part">{p}</span>)}</td>
          <td>{r.where}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
