---
/** An English short beside its Polish adaptation, both as click-to-load facades, with a caption. */
import VideoFacade from './VideoFacade.astro';
import type { ImageMetadata } from 'astro';
interface Side { id: string; title: string; views: string; thumb: ImageMetadata; }
interface Props { en: Side; pl: Side; caption: string; }
const { en, pl, caption } = Astro.props;
---

<figure class="pair">
  <div class="pair__grid">
    <VideoFacade id={en.id} title={en.title} thumb={en.thumb} meta={`English, ${en.views} views`} />
    <VideoFacade id={pl.id} title={pl.title} thumb={pl.thumb} meta={`Polish, ${pl.views} views`} lang="pl" />
  </div>
  <figcaption class="pair__cap small">
    <span class="pair__label">Matched pair</span>
    <span class="muted">{caption}</span>
  </figcaption>
</figure>

<style>
  .pair__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(4, auto); column-gap: var(--space-5); row-gap: 0; max-width: 36rem; }
  .pair__cap { display: grid; justify-items: start; gap: 0.15rem; padding-top: var(--space-3); margin-top: var(--space-4); max-width: var(--measure); }
  .pair__label { color: var(--ink); font-weight: 500; flex: none; }
  @media (max-width: 420px) { .pair__grid { column-gap: var(--space-3); } }
</style>
