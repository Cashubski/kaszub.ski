---
/**
 * The contact email (BRIEF.md §14.5), assembled in the browser from two data attributes so the
 * address is never plain text in the HTML. Without JavaScript the link points at the PDF CV,
 * which carries the address, and shows the fallback wording instead.
 */
import { person } from '../data/site';
interface Props { class?: string; fallback?: string; }
const { class: cls, fallback = 'the address in my PDF CV' } = Astro.props;
---

<a class:list={['email', cls]} data-email-u={person.emailUser} data-email-d={person.emailDomain} href="/Michal-Kaszubski-CV.pdf">{fallback}</a>

<script>
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-email-u]')) {
    const address = `${a.dataset.emailU}@${a.dataset.emailD}`;
    a.href = `mailto:${address}`;
    a.textContent = address;
  }
</script>
