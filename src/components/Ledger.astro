---
/**
 * The evidence ledger: three verified figures, each with a context line and a date where the
 * number changes over time. Set as an ink-dark full-bleed section: serif figures, sans context,
 * rows separated by hairlines. Not a dashboard: no cards, no icons, no equal columns.
 */
import { ledger } from '../data/site';
---

<section class="ledger ink" aria-labelledby="ledger-title">
  <div class="container">
    <div class="ledger__head grid" data-reveal-group>
      <h2 id="ledger-title" class="serif ledger__title">The evidence, in context</h2>
      <p class="ledger__intro">Three figures from the work below. Each is labelled by the kind of evidence it is, and dated where it changes over time.</p>
    </div>
    <ol class="ledger__list" role="list">
      {ledger.map((row) => (
        <li class="ledger__row grid" data-reveal="block" data-rule>
          <p class="ledger__figure figure-num"><span data-count aria-hidden="true">{row.value}</span><span class="visually-hidden">{row.value}</span></p>
          <div class="ledger__text">
            <p class="ledger__unit">{row.unit}</p>
            <p class="ledger__context small muted">{row.context}</p>
          </div>
          <p class="ledger__aside small">
            <span class="ledger__kind">{row.kind}</span>
            <span class="muted">{row.asOf}</span>
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ledger { padding-block: var(--space-8) var(--space-8); }
  .ledger__head { row-gap: var(--space-4); align-items: end; margin-bottom: var(--space-6); }
  .ledger__title { grid-column: 1 / span 5; font-size: var(--step-3); letter-spacing: var(--tracking-title); line-height: 1.05; }
  .ledger__intro { grid-column: 7 / span 5; color: var(--ink-2); max-width: 46ch; }
  .ledger__row { border-top: 1px solid var(--rule); padding-block: var(--space-5) var(--space-6); row-gap: var(--space-3); align-items: start; }
  .ledger__row:last-child { border-bottom: 1px solid var(--rule); }
  .ledger__figure { grid-column: 1 / span 5; font-size: var(--step-4); line-height: 1; letter-spacing: -0.025em; }
  .ledger__text { grid-column: 6 / span 5; display: grid; gap: var(--space-1); padding-top: 0.35rem; }
  .ledger__unit { font-size: var(--step-1); line-height: 1.3; color: var(--ink); }
  .ledger__context { max-width: 42ch; }
  .ledger__aside { grid-column: 11 / span 2; display: grid; gap: 0.1rem; padding-top: 0.5rem; }
  .ledger__kind { color: var(--ink); font-weight: 500; }
  @media (max-width: 900px) {
    .ledger__title, .ledger__intro { grid-column: 1 / -1; }
    .ledger__figure { grid-column: 1 / -1; }
    .ledger__text { grid-column: 1 / span 8; padding-top: 0; }
    .ledger__aside { grid-column: 9 / -1; padding-top: 0; }
  }
  @media (max-width: 560px) {
    .ledger__text, .ledger__aside { grid-column: 1 / -1; }
    .ledger__aside { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); }
  }
</style>
