---
/**
 * AI Zuzi layered architecture (BRIEF.md §13.2, reduced to product level by §14.4): layer, component,
 * what it does. Each row was read from the private repository on 20 September 2026 and is stated here
 * at the level of the CV bullets: no counts, lifetimes, limits, endpoints, library names or client detail.
 * No secrets, hosts, app ids, user data or client names. Names are set in Instrument Sans; there is no monospace here.
 */
interface Row { layer: string; parts: string[]; does: string; }
const rows: Row[] = [
  {
    layer: 'Interface',
    parts: ['React, Vite, Tailwind CSS', 'five interface languages'],
    does: 'Composer with a live phone preview, schedule calendar, media library, Creative Studio, assistant, statistics with a printable PDF report, a command palette and a system-status page. English, Polish, German, Dutch and Czech.',
  },
  {
    layer: 'API',
    parts: ['Django, Django REST Framework', 'JWT authentication with roles'],
    does: 'One REST surface for the single-page app, with rate limits on the sign-in, second-factor and generation routes.',
  },
  {
    layer: 'Identity',
    parts: ['Multi-factor sign-in', 'email one-time code or authenticator app'],
    does: 'A second factor on every route in, enrolled by emailed code or by an authenticator app.',
  },
  {
    layer: 'Publishing',
    parts: ['Meta Graph API, Instagram Business Login', 'YouTube, TikTok, Pinterest, Threads, LinkedIn, Google Business Profile, WordPress'],
    does: 'A post is composed once, scheduled, and published to each connected channel by that channel’s own service. Facebook and Instagram in every format the platforms take; blog publishing to WordPress.',
  },
  {
    layer: 'Generation',
    parts: ['Text, image and video generation APIs', 'an assistant with a prompt library'],
    does: 'Post text from parameters, from an image or from a link; blog drafts; image and video generation in Creative Studio, each priced in tokens.',
  },
  {
    layer: 'Payments',
    parts: ['Stripe Checkout', 'webhooks and invoices'],
    does: 'Token packages are bought through hosted checkout, credited once per purchase and invoiced automatically.',
  },
  {
    layer: 'Media',
    parts: ['Cloudflare R2 object storage'],
    does: 'Uploads, generated media and brand assets live in object storage under public URLs that the platforms can fetch. Images are converted on the way in to the format the platforms take.',
  },
  {
    layer: 'Data',
    parts: ['PostgreSQL', 'migrated live from SQLite'],
    does: 'A zero-data-loss live migration from SQLite to PostgreSQL, so that the scheduler and the web workers can write at the same time.',
  },
  {
    layer: 'Security',
    parts: ['Encryption at rest for stored credentials', 'rate limiting, request-forgery guards, log redaction, GDPR-aligned deletion'],
    does: 'The security audit’s findings, applied: provider tokens and other credentials are encrypted in the database, user-supplied URLs are checked before they are fetched, and account deletion is real and scheduled.',
  },
  {
    layer: 'Operations',
    parts: ['GitHub Actions, automated tests', 'error monitoring, an audit log'],
    does: 'A push deploys only when the tests and the front-end build pass. Errors from both sides are reported. An audit log records sign-in, publishing, generation, payment and media events.',
  },
];
---

<div class="table-wrap wide az-stack">
  <table>
    <thead>
      <tr><th scope="col">Layer</th><th scope="col">Component</th><th scope="col">What it does</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td>{r.layer}</td>
          <td>{r.parts.map((p) => <span class="az-part">{p}</span>)}</td>
          <td>{r.does}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style is:global>
  .prose .az-stack table { table-layout: fixed; font-size: var(--step--1); }
  .prose .az-stack th:nth-child(1) { width: 19%; }
  .prose .az-stack th:nth-child(2) { width: 32%; }
  .prose .az-stack :is(th, td) { padding-block: 0.8em; padding-right: 1.6em; }
  .prose .az-stack td:first-child { font-family: var(--font-serif); font-size: var(--step-1); line-height: 1.2; letter-spacing: var(--tracking-title); color: var(--ink); }
  .prose .az-stack td:nth-child(3) { padding-right: 0; line-height: 1.5; }
  .az-stack .az-part { display: block; color: var(--ink); font-weight: 500; font-variant-numeric: tabular-nums lining-nums; overflow-wrap: anywhere; }
  .az-stack .az-part + .az-part { margin-top: 0.3em; font-weight: 400; color: var(--ink-2); }
  @media (max-width: 640px) {
    .prose .table-wrap.az-stack:not(.table-wrap--nums) tbody tr { grid-template-columns: 1fr; row-gap: 0.4em; padding-block: 1em; }
    .prose .table-wrap.az-stack:not(.table-wrap--nums) td:first-child { color: var(--ink); }
    .prose .table-wrap.az-stack:not(.table-wrap--nums) td { grid-column: 1 / -1; }
  }
</style>
